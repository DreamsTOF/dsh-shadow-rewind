  "cards": [
    {
      "dot": "cyan",
      "title": "两条铁律",
      "items": [
        "文件枚举只走目录扫描，绝不触碰工作区自身的 .git / .jj",
        "恢复五闸：计划限时 + 确认串 + rescue 备份 + 操作日志 + 事后验证"
      ]
    },
    {
      "dot": "violet",
      "title": "三层 diff 来源",
      "items": [
        "快照配对：轮起 ↔ 轮末检查点，终端与外部写盘也可见",
        "轨迹重放：write / edit / str_replace_editor，历史会话可用",
        "工具 hunk：轮尾卡片逐块撤销/重做"
      ]
    },
    {
      "dot": "amber",
      "title": "双后端与降级",
      "items": [
        "jj CLI 可用：隐藏影子仓库，每次快照一条 jj commit",
        "jj 缺失：自动降级 node:sqlite 内容库，功能不中断"
      ]
    }
  ]
